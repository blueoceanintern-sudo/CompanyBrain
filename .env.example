DATABASE_URL=postgresql://user:password@localhost:5432/blueocean
POSTGRES_USER=user
POSTGRES_PASSWORD=password

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

STRIPE_WEBHOOK_SECRET=
STRIPE_ORG_PRICE_ID=
STRIPE_PLATFORM_FEE_PERCENT=15

JWT_SECRET=change-me-in-production

NODE_ENV=development
PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_WEB_URL=http://localhost:3000

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Contact Administrator Email (Login)
NEXT_PUBLIC_SUPPORT_EMAIL=

AI_CHAT_PROVIDER=openai-compatible
AI_CHAT_MODEL=gpt-4o-mini

# Original uploaded files (services/storage). Local dev writes to apps/api/.storage;
# in Docker this is /data/documents and MUST be a persistent volume.
STORAGE_DRIVER=local
STORAGE_ROOT=./.storage 